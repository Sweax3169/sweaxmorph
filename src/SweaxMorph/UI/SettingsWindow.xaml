<Window x:Class="SweaxMorph.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SweaxMorph.UI"
        Width="860" Height="680" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Haze}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource Rounded}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Margin" Value="0,30,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink2}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="30,2,0,0"/>
        </Style>
        <Style x:Key="Row" TargetType="ToggleButton" BasedOn="{StaticResource Drop}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="-7,12,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- candy light in the corners -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True" Grid.ColumnSpan="2">
            <Ellipse Width="520" Height="520" Canvas.Left="-200" Canvas.Top="-220" Opacity="0.55">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#66CDB8FF" Offset="0"/><GradientStop Color="#00CDB8FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="560" Height="560" Canvas.Left="480" Canvas.Top="380" Opacity="0.5">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#55FF8FC1" Offset="0"/><GradientStop Color="#00FF8FC1" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Morph and the name -->
        <StackPanel Margin="0,36,0,0" HorizontalAlignment="Center">
            <ui:Blob x:Name="Morph" Width="190" Height="190" Radius="62"/>
            <TextBlock Text="SweaxMorph" FontSize="27" FontWeight="Black" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock x:Name="Tagline" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock x:Name="VersionText" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Ink3}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12.5" FontWeight="ExtraBold">
                <Hyperlink x:Name="Repo" NavigateUri="https://github.com/Sweax3169/sweaxmorph" Foreground="{DynamicResource Accent}" TextDecorations="None">github.com/Sweax3169/sweaxmorph</Hyperlink>
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="10,6,44,40">
                <!-- shortcut -->
                <TextBlock x:Name="HShortcut" Style="{StaticResource H}"/>
                <TextBlock x:Name="ShortcutHint" Style="{StaticResource Hint}" Margin="0,0,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ItemsControl x:Name="Keys" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinWidth="40" Height="40" Padding="12,0" Margin="0,0,8,0" CornerRadius="11" Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,3">
                                    <TextBlock Text="{Binding}" FontSize="15" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="RecordButton" Style="{StaticResource Word}" Tag="&#xE70F;" VerticalAlignment="Center" Margin="6,0,0,0" Click="Record_Click"/>
                </StackPanel>
                <TextBlock x:Name="RecordStatus" Style="{StaticResource Hint}" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" FontWeight="Bold" Visibility="Collapsed"/>
                <TextBlock x:Name="MacroHint" Style="{StaticResource Hint}" Margin="0,10,0,2"/>
                <ToggleButton x:Name="DragToggle" Style="{StaticResource Row}" Click="Toggle_Click"/>
                <TextBlock x:Name="DragHint" Style="{StaticResource Hint}"/>

                <!-- explorer -->
                <TextBlock x:Name="HExplorer" Style="{StaticResource H}"/>
                <ToggleButton x:Name="MenuToggle" Style="{StaticResource Row}" Margin="-7,6,0,0" Click="Toggle_Click"/>
                <TextBlock x:Name="MenuHint" Style="{StaticResource Hint}"/>

                <!-- output -->
                <TextBlock x:Name="HOutput" Style="{StaticResource H}"/>
                <StackPanel Orientation="Horizontal" Margin="-7,8,0,0">
                    <ToggleButton x:Name="OutBeside" Style="{StaticResource Drop}" FontSize="14" Click="Output_Click"/>
                    <ToggleButton x:Name="OutDesktop" Style="{StaticResource Drop}" FontSize="14" Click="Output_Click"/>
                    <ToggleButton x:Name="OutCustom" Style="{StaticResource Drop}" FontSize="14" Click="Output_Click"/>
                </StackPanel>
                <StackPanel x:Name="CustomRow" Orientation="Horizontal" Margin="30,8,0,0">
                    <TextBlock x:Name="CustomPath" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ChooseButton" Style="{StaticResource Word}" Tag="&#xE838;" Click="Choose_Click"/>
                </StackPanel>

                <!-- quality -->
                <TextBlock x:Name="HQuality" Style="{StaticResource H}"/>
                <TextBlock x:Name="QualityHint" Style="{StaticResource Hint}" Margin="0"/>
                <StackPanel Orientation="Horizontal" Margin="-7,10,0,0">
                    <ToggleButton x:Name="QBest" Style="{StaticResource Drop}" FontSize="14" Click="Quality_Click"/>
                    <ToggleButton x:Name="QBalanced" Style="{StaticResource Drop}" FontSize="14" Click="Quality_Click"/>
                    <ToggleButton x:Name="QSmall" Style="{StaticResource Drop}" FontSize="14" Click="Quality_Click"/>
                </StackPanel>

                <!-- engines -->
                <TextBlock x:Name="HEngines" Style="{StaticResource H}"/>
                <TextBlock x:Name="EnginesHint" Style="{StaticResource Hint}" Margin="0"/>
                <StackPanel x:Name="EngineList" Margin="0,10,0,0"/>

                <!-- general -->
                <TextBlock x:Name="HGeneral" Style="{StaticResource H}"/>
                <ToggleButton x:Name="StartupToggle" Style="{StaticResource Row}" Margin="-7,6,0,0" Click="Toggle_Click"/>
                <ToggleButton x:Name="FolderToggle" Style="{StaticResource Row}" Click="Toggle_Click"/>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock x:Name="LangLabel" FontSize="14" FontWeight="Black" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleButton x:Name="LangAuto" Style="{StaticResource Drop}" FontSize="14" Click="Lang_Click"/>
                        <ToggleButton x:Name="LangEn" Style="{StaticResource Drop}" FontSize="14" Content="English" Click="Lang_Click"/>
                        <ToggleButton x:Name="LangTr" Style="{StaticResource Drop}" FontSize="14" Content="Türkçe" Click="Lang_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="ThemeLabel" Grid.Row="1" FontSize="14" FontWeight="Black" VerticalAlignment="Center" Margin="0,12,0,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <ToggleButton x:Name="ThemeSystem" Style="{StaticResource Drop}" FontSize="14" Click="Theme_Click"/>
                        <ToggleButton x:Name="ThemeLight" Style="{StaticResource Drop}" FontSize="14" Click="Theme_Click"/>
                        <ToggleButton x:Name="ThemeDark" Style="{StaticResource Drop}" FontSize="14" Click="Theme_Click"/>
                    </StackPanel>
                </Grid>

                <!-- formats -->
                <TextBlock x:Name="HFormats" Style="{StaticResource H}"/>
                <TextBlock x:Name="FormatsHint" Style="{StaticResource Hint}" Margin="0"/>
                <WrapPanel x:Name="KindChips" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
