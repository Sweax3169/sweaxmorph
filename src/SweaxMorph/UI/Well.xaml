<Window x:Class="SweaxMorph.UI.Well"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:SweaxMorph.UI"
        Title="SweaxMorph" Width="600" Height="690"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" AllowDrop="True"
        FontFamily="{DynamicResource Rounded}" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.4">
        <Grid.RenderTransform><ScaleTransform x:Name="RootScale"/></Grid.RenderTransform>

        <!-- the haze: a soft cloud of the theme colour that keeps text readable over any desktop -->
        <Ellipse x:Name="Haze" Margin="-10,0,-10,-20">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.47" GradientOrigin="0.5,0.47" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop x:Name="HazeInner" Color="{DynamicResource HazeColor}" Offset="0.5"/>
                    <GradientStop x:Name="HazeEdge" Color="{DynamicResource HazeClearColor}" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Canvas x:Name="Stage">
            <ui:Blob x:Name="Morph" Width="300" Height="300" Canvas.Left="150" Canvas.Top="100" RenderTransformOrigin="0.5,0.5" Cursor="Hand">
                <ui:Blob.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MorphScale"/>
                        <TranslateTransform x:Name="MorphMove"/>
                    </TransformGroup>
                </ui:Blob.RenderTransform>
            </ui:Blob>
            <Canvas x:Name="Petals"/>
        </Canvas>

        <!-- count of files held, a little badge on Morph's head -->
        <Border x:Name="Count" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="364,138,0,0"
                MinWidth="28" Height="28" CornerRadius="14" Padding="7,0" Background="{DynamicResource Surface}" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18"/></Border.Effect>
            <TextBlock x:Name="CountText" FontWeight="Black" FontSize="13.5" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Ink}"/>
        </Border>

        <!-- settings and close, just outside the ring of petals -->
        <StackPanel x:Name="Corner" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="496,34,0,0">
            <Button x:Name="SettingsButton" Style="{StaticResource Mini}" Tag="&#xE713;" Click="Settings_Click"/>
            <Button x:Name="CloseButton" Style="{StaticResource Mini}" Tag="&#xE711;" Click="Close_Click"/>
        </StackPanel>

        <!-- what is going on, under Morph -->
        <StackPanel x:Name="Info" VerticalAlignment="Top" HorizontalAlignment="Center" Width="470" Margin="0,486,0,0">
            <TextBlock x:Name="TitleText" FontSize="23" FontWeight="Black" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubText" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Ink2}" TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>

            <!-- picking: quality and combine -->
            <StackPanel x:Name="Options" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <ToggleButton x:Name="QBest" Style="{StaticResource Drop}" Click="Quality_Click"/>
                <ToggleButton x:Name="QBalanced" Style="{StaticResource Drop}" Click="Quality_Click"/>
                <ToggleButton x:Name="QSmall" Style="{StaticResource Drop}" Click="Quality_Click"/>
                <Rectangle x:Name="OptionsGap" Width="1" Height="14" Fill="{DynamicResource Line}" Margin="10,0"/>
                <ToggleButton x:Name="Combine" Style="{StaticResource Drop}" Click="Combine_Click"/>
            </StackPanel>

            <!-- working -->
            <Button x:Name="StopButton" Style="{StaticResource Word}" Tag="&#xE71A;" HorizontalAlignment="Center" Margin="0,12,0,0" Click="Stop_Click"/>

            <!-- done -->
            <ItemsControl x:Name="Results" Margin="0,14,0,0" MaxHeight="150">
                <ItemsControl.Template>
                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>
            <StackPanel x:Name="DoneActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="AgainButton" Style="{StaticResource Word}" Tag="&#xE72C;" Click="Again_Click"/>
                <Button x:Name="FixButton" Style="{StaticResource Word}" Tag="&#xE896;" Click="Fix_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- every format: a searchable garden of droplets -->
        <Grid x:Name="MoreSheet" Visibility="Collapsed" Margin="40,150,40,40">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid Margin="20,0,20,8">
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource Ink3}" VerticalAlignment="Center"/>
                <TextBox x:Name="Search" Margin="26,0,0,0" FontSize="17" FontWeight="ExtraBold" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Accent}" TextChanged="Search_TextChanged" VerticalContentAlignment="Center" Padding="0,6"/>
                <TextBlock x:Name="SearchHint" Margin="28,0,0,0" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource Ink3}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                <ui:WaveLine x:Name="Wave" Height="8" VerticalAlignment="Bottom" Margin="0,0,0,-6" Stroke="{DynamicResource Accent}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,8,0,0">
                <StackPanel x:Name="Garden" Margin="12,0"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
